# Copy to deploy/local.env (gitignored). Secrets stay on your Mac and the app container only.
DEPLOY_HOST=pve-berlin
DEPLOY_CT=209
SITE_HOST=leads.193vbr.com
TUNNEL_NAME=gm-leads
# HubSpot private app token (scopes: crm.objects.companies.read/write, crm.objects.contacts.read/write, crm.schemas.companies.write, crm.schemas.contacts.write)
